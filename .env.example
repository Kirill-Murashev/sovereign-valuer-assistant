# Sovereign Valuer Assistant local configuration
# Copy this file to .env and fill in local values.
# Do not commit .env.

# Runtime
SVA_ENV=local
SVA_LOG_LEVEL=INFO

# LLM provider
SVA_LLM_PROVIDER=gigachat

# GigaChat
# Fill according to the authentication method used in your local implementation.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# Paths
SVA_KNOWLEDGE_BASE_DIR=knowledge_base
SVA_SKILLS_DIR=skills
SVA_MEMORY_DIR=memory
SVA_DATA_HUB_DIR=data_hub

# Retrieval defaults
SVA_CHUNK_SIZE=1000
SVA_CHUNK_OVERLAP=150
SVA_TOP_K=5

# Safety
SVA_ALLOW_MEMORY_WRITE=false
SVA_ALLOW_NETWORK_TOOLS=false
